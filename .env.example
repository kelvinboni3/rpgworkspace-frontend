# Dev: caminho relativo — o proxy do Vite (server.proxy/preview.proxy em vite.config.ts)
# encaminha /api para o backend local (porta 5069/7019, ver launchSettings.json).
VITE_API_BASE_URL=/api

# Produção (Vercel/Cloudflare Pages): URL absoluta da API, ex.:
# VITE_API_BASE_URL=https://api.seudominio.com.br/api

# Tags de marketing (opcionais — sem elas, nenhum rastreamento é carregado).
# Google tag: GA4 ("G-XXXX") ou Google Ads ("AW-XXXX"). Meta Pixel: só o ID numérico.
# Em produção, definir no deploy.sh do VPS (env do build do front).
# VITE_GOOGLE_TAG_ID=
# VITE_META_PIXEL_ID=
